/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh; style-src 'self'; img-src 'self' data:; connect-src 'self' wss: https://esm.sh; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
